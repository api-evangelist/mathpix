  "item": [
    {
      "id": "f253e961-3c23-4484-904f-c517fc4b31d7",
      "name": "App Tokens",
      "description": {
        "content": "Issue temporary client-side tokens.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "c05888e3-95eb-45d3-80e5-5113d798a3c0",
          "name": "Create An App Token",
          "request": {
            "name": "Create An App Token",
            "description": {
              "content": "Mint a temporary app_token for client-side use. Authenticated with the long-lived app_key only.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v3",
                "app-tokens"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) Long-lived Mathpix application secret.",
                "key": "app_key",
                "value": "<string>"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"expires\": 300,\n  \"include_strokes_session_id\": \"<boolean>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "79e833f0-508b-448c-8f48-02f1b3371a65",
              "name": "Token issued.",
              "originalRequest": {
                "url": {
                  "path": [
                    "v3",
                    "app-tokens"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": []
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: apikey",
                      "type": "text/plain"
                    },
                    "key": "app_key",
                    "value": "<API Key>"
                  },
                  {
                    "disabled": false,
                    "description": "(Required) Long-lived Mathpix application secret.",
                    "key": "app_key",
                    "value": "<string>"
                  },
                  {
                    "disabled": false,
                    "description": "(Required) ",
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"expires\": 300,\n  \"include_strokes_session_id\": \"<boolean>\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"app_token\": \"string\",\n  \"app_token_expires_at\": 1523,\n  \"strokes_session_id\": \"string\"\n}",
              "cookie": [],
              "_postman_previewlanguage": "json"
            }
          ],
          "event": [],
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          }
        }
      ],
      "event": []
    }
  ],
  "event": [],
  "variable": [
    {
      "type": "string",
      "value": "https://api.mathpix.com",
      "key": "baseUrl"
    }
  ],
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "app_key"
      },
      {
        "key": "value",
        "value": "{{apiKey}}"
      },
      {
        "key": "in",
        "value": "header"
      }
    ]
  },
  "info": {
    "_postman_id": "51f48e48-f3b0-4439-83c0-09e49d2a0241",
    "name": "Mathpix App Tokens API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Mint short-lived client-side tokens so browsers, mobile apps, and digital-ink surfaces can call Mathpix without exposing your long-lived app_key. Tokens default to 5 minutes and can be issued from 30 seconds to 12 hours. Token issuance is free.\n\n\nContact Support:\n Name: Mathpix Support\n Email: support@mathpix.com",
      "type": "text/plain"
    }
  }
}