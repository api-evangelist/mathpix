{
  "opencollection": "1.0.0",
  "info": {
    "name": "Mathpix Batch API",
    "version": "v3"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "app_id",
      "value": "{{app_id}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Batches",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Submit A Batch",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.mathpix.com/v3/batch",
            "headers": [
              {
                "name": "app_id",
                "value": ""
              },
              {
                "name": "app_key",
                "value": ""
              },
              {
                "name": "Content-Type",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Submit a batch of image URLs (with optional per-image options) for OCR. Poll results using the returned batch_id."
        },
        {
          "info": {
            "name": "Get Batch Results",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.mathpix.com/v3/batch/:batch_id",
            "headers": [
              {
                "name": "app_id",
                "value": ""
              },
              {
                "name": "app_key",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "batch_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve OCR results for the batch. Mathpix recommends waiting approximately one second per five images before polling."
        }
      ]
    }
  ],
  "bundled": true
}