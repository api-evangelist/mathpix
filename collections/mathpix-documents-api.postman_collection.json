    "name": "Mathpix Document OCR Documents API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Mathpix v3/pdf endpoints for asynchronous document OCR and format conversion. Submit PDFs (and other supported documents) by URL or multipart upload, poll status, and download results in MMD, Markdown, DOCX, LaTeX (.tex.zip), HTML, PPTX, or line-by-line JSON. Includes server-sent event streaming for incremental results.\n\n\nContact Support:\n Name: Mathpix Support\n Email: support@mathpix.com",
      "type": "text/plain"
    }
  }
