                      },
                      {
                        "key": "Accept",
                        "value": "application/json"
                      },
                      {
                        "description": "Added as a part of security scheme: apikey",
                        "key": "app_key",
                        "value": "<API Key>"
                      }
                    ],
                    "body": {
                      "mode": "raw",
                      "raw": "{\n  \"expires\": 300,\n  \"include_strokes_session_id\": \"<boolean>\"\n}",
                      "options": {
                        "raw": {
                          "headerFamily": "json",
                          "language": "json"
                        }
                      }
                    },
                    "url": {
                      "raw": "{{baseUrl}}/v3/app-tokens",
                      "host": [
                        "{{baseUrl}}"
                      ],
                      "path": [
                        "v3",
                        "app-tokens"
                      ]
