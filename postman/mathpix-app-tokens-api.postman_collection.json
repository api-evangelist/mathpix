  "info": {
    "_postman_id": "dec117c3-e175-442d-8cf7-f775374423ce",
    "name": "Mathpix App Tokens API",
    "description": "Mint short-lived client-side tokens so browsers, mobile apps, and digital-ink surfaces can call Mathpix without exposing your long-lived app_key. Tokens default to 5 minutes and can be issued from 30 seconds to 12 hours. Token issuance is free.\n\n\nContact Support:\n Name: Mathpix Support\n Email: support@mathpix.com",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-07-28T10:58:17.000Z",
    "updatedAt": "2026-07-28T10:58:17.000Z",
    "lastUpdatedBy": "35240",
    "uid": "35240-dec117c3-e175-442d-8cf7-f775374423ce"
  },
  "item": [
    {
      "name": "v3",
      "item": [
        {
          "name": "app-tokens",
          "item": [
            {
              "name": "Create An App Token",
              "id": "75c82550-bc00-4f33-b9b5-4f29038776cf",
              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "method": "POST",
                "header": [
                  {
                    "description": "(Required) Long-lived Mathpix application secret.",
                    "key": "app_key",
                    "value": "<string>"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"expires\": 300,\n  \"include_strokes_session_id\": \"<boolean>\"\n}",
                  "options": {
                    "raw": {
                      "headerFamily": "json",
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{baseUrl}}/v3/app-tokens",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "v3",
                    "app-tokens"
                  ]
                },
                "description": "Mint a temporary app_token for client-side use. Authenticated with the long-lived app_key only."
              },
              "response": [
                {
                  "id": "0ad24611-7646-4380-b622-7fefcf8975ab",
                  "name": "Token issued.",
                  "originalRequest": {
                    "method": "POST",
                    "header": [
                      {
